# BUILD
FROM node:24-alpine AS builder

RUN apk add --no-cache bash git python3 perl alpine-sdk

WORKDIR /opt/app

COPY telepathy-agent telepathy-agent
COPY _shared _shared

RUN cd telepathy-agent && \
    npm ci && \
    npm run build


# RUN
FROM node:24-alpine

RUN apk add --no-cache libstdc++ libgcc && \
    mkdir /workspace

COPY --from=builder /opt/app/telepathy-agent/dist /opt/app/telepathy-agent/dist
COPY --from=builder /opt/app/telepathy-agent/node_modules /opt/app/telepathy-agent/node_modules
COPY --from=builder /opt/app/telepathy-agent/package.json /opt/app/telepathy-agent/package.json

WORKDIR /workspace

CMD [ "node", "/opt/app/telepathy-agent/dist/app.js" ]
