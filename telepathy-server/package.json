{
  "name": "telepathy-server",
  "version": "2.0.1",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dependencies": "rm -fr src/common-model && cp -R ../_shared/common-model src/common-model && rm -fr src/utils-std-ts && cp -R ../_shared/utils-std-ts src/utils-std-ts",
    "//": "-------------------------------------------------------------------",
    "build": "npm run dependencies && tsc",
    "lint": "eslint src || true",
    "test": "jest --coverage || true",
    "test:dev": "jest --watch --coverage",
    "////": "-----------------------------------------------------------------",
    "dev": "ts-node-dev ./src/app.ts",
    "dev:test": "NODE_ENV=dev jest --watch --config='jest.config.js'",
    "binary:alpine:x64": "npm run build && pkg dist/app.js --target node16-alpine-x64 --output ./dist/telepathy-server-linux-alpine",
    "binary:linux:x64": "npm run build && pkg dist/app.js --target node16-linux-x64 --output ./dist/telepathy-server-linux-x64",
    "binary:linux:armv6": "npm run build && pkg dist/app.js --target node14-linux-armv6 --output ./dist/telepathy-server-linux-armv6",
    "binary:linux:arm64": "npm run build && pkg dist/app.js --target arm64 --output ./dist/telepathy-server-linux-armv7"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/id-generator-aws-xray": "^2.1.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-web": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.3.0",
    "fastify": "^5.12.1",
    "fs-extra": "^11.4.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "md5-file": "^5.0.0",
    "node-cron": "^4.6.0",
    "pino-pretty": "^13.1.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "sinon": "^22.1.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0"
  }
}
