{
  "name": "telepathy-server",
  "version": "1.5.2",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dependencies": "rm -fr src/common-model && cp -R ../_shared/common-model src/common-model && rm -fr src/utils-std-ts && cp -R ../_shared/utils-std-ts src/utils-std-ts",
    "//": "-------------------------------------------------------------------",
    "build": "npm run dependencies && tsc",
    "lint": "eslint src || true",
    "test": "jest --coverage || true",
    "test:dev": "jest --watch --coverage",
    "////": "-----------------------------------------------------------------",
    "dev": "ts-node-dev ./src/app.ts",
    "dev:test": "NODE_ENV=dev jest --watch --config='jest.config.js'",
    "binary:alpine:x64": "npm run build && pkg dist/app.js --target node16-alpine-x64 --output ./dist/telepathy-server-linux-alpine",
    "binary:linux:x64": "npm run build && pkg dist/app.js --target node16-linux-x64 --output ./dist/telepathy-server-linux-x64",
    "binary:linux:armv6": "npm run build && pkg dist/app.js --target node14-linux-armv6 --output ./dist/telepathy-server-linux-armv6",
    "binary:linux:arm64": "npm run build && pkg dist/app.js --target arm64 --output ./dist/telepathy-server-linux-armv7"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.49.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.1",
    "@opentelemetry/id-generator-aws-xray": "^1.2.2",
    "@opentelemetry/resources": "^1.25.1",
    "@opentelemetry/sdk-node": "^0.52.1",
    "@opentelemetry/sdk-trace-base": "^1.25.1",
    "@opentelemetry/sdk-trace-web": "^1.25.1",
    "@opentelemetry/semantic-conventions": "^1.25.1",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "fastify": "^4.28.1",
    "fs-extra": "^11.2.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "md5-file": "^5.0.0",
    "node-cron": "^3.0.3",
    "pino-pretty": "^11.2.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.7",
    "@types/node": "^22.2.0",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.9.0",
    "jest": "^29.7.0",
    "sinon": "^18.0.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.1"
  }
}
